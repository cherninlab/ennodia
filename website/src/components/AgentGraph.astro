---
import Icon from "./Icon.astro";
import AgentIcon from "./AgentIcon.astro";
import { agent, graphAgents, graphTasks, middleRow, route, routeText, type GraphAgentId, type TaskId } from "../data/agents";
import { AGENTS, ANSWER_Y, CALL_Y, CHAT, STAGE, STRIP, backPath, comparePoint, idlePath, manualSteps, outPath, percent } from "../data/graph-layout";

// Fig. 2. Agents are boxes, and Ennodia is the path between them: the only
// olive in the drawing. Your chat is one window. The path leaves from your
// agent's tool call, runs through the agent that does the work, and comes
// back into the same window. scripts/agent-graph.ts switches the agent you
// work in, the task, and whether Ennodia is there at all. The server renders
// the first state, so the figure reads without script.
const from: GraphAgentId = "codex";
const taskId: TaskId = "listen";
const task = graphTasks.find((entry) => entry.id === taskId)!;
const row = middleRow(from);
const { workers, compare } = route(from, taskId);
const text = routeText(from, taskId);
const you = agent(from);
const rows = workers.map((id) => row.indexOf(id));

const x = (value: number) => percent(value, STAGE.width);
const y = (value: number) => percent(value, STAGE.height);
const icons = { listen: "listen", draw: "draw", review: "review", long: "read" } as const;

// Each task shows its capability as a record of a real run, drawn with
// pyqtgraph: an exhibit, so the caption says what it shows and when. Listen
// is clip 27 of the audio pilot (bench/audio-routing/scope.py). The others
// come from bench/strips: GPT Image textures from Codex, two reviews of an
// Ennodia patch under Compare, and Kimi K3 reading RFC 9110.
type Strip = { task: TaskId; name: string; note: string; credit?: { text: string; href: string } };
const strips: Strip[] = [
  {
    task: "listen",
    name: "perception-strip",
    note: "The strip shows clip 27 of the audio pilot, September 26, 2026. Codex got it right only through Gemini.",
    // MMAU is CC BY-NC 4.0, so its clip is credited where it shows.
    credit: { text: "Clip from MMAU test-mini, GAMMA Lab, University of Maryland, CC BY-NC 4.0", href: "https://huggingface.co/datasets/gamma-lab-umd/MMAU-test-mini" },
  },
  { task: "draw", name: "draw-strip", note: "The strip shows the four stone textures Codex drew with GPT Image, September 26, 2026. A trace marks each tiling seam." },
  { task: "review", name: "review-strip", note: "The strip shows two reviews of an Ennodia patch, September 26, 2026. Squares mark Claude Code’s four findings. Brackets mark what Kimi K3 read and cited." },
  { task: "long", name: "read-strip", note: "The strip shows Kimi K3 reading all 10,785 lines of RFC 9110, September 26, 2026, and the 49 rules it listed." },
];
const shown = strips.find((strip) => strip.task === taskId)!;
const credit = shown.credit;
const join = comparePoint(rows.length ? rows : [0]);
const steps = manualSteps(rows.length ? rows : [0]);
---
<section class="wrap abilities" id="abilities" aria-labelledby="abilities-title" data-graph>
  <div class="abilities-head" data-reveal>
    <h2 id="abilities-title">Your agent stays in charge</h2>
    <p>Follow the olive line in Fig. 2. It leaves your agent’s tool call, runs through the agent that does the work, and returns to the same chat. Pick a task to change the route.</p>
  </div>

  <div class="fig-toolbar" data-reveal>
    <div class="fig-tasks" role="group" aria-label="Task">
      {graphTasks.map((entry) => {
        return (
          <button type="button" data-task={entry.id} aria-pressed={entry.id === taskId ? "true" : "false"}>
            <Icon name={icons[entry.id]} size={18} /><span>{entry.tab}</span>
          </button>
        );
      })}
    </div>
    <div class="fig-mode" role="group" aria-label="Ennodia">
      <button type="button" data-mode="on" aria-pressed="true">With Ennodia</button>
      <button type="button" data-mode="off" aria-pressed="false">Without</button>
    </div>
  </div>

  <figure class={`fig${workers.length ? "" : " is-self"}`} data-reveal>
    <div class="fig-stage" style={`--call: ${y(CALL_Y)}; --answer: ${y(ANSWER_Y)}`}>
      <svg class="fig-paths" viewBox={`0 0 ${STAGE.width} ${STAGE.height}`} aria-hidden="true">
        <path class="fig-idle" d={idlePath()} />
        <path class="fig-route" data-out d={rows.length ? outPath(rows) : ""} />
        <path class="fig-route" data-back d={rows.length ? backPath(rows) : ""} />
        <circle class="fig-join" data-join cx={join.x} cy={join.y} r="4" hidden={!compare} />
        {AGENTS.rows.map((rowY, index) => [AGENTS.x, AGENTS.x + AGENTS.width].map((portX) => (
          <circle class={`fig-port${rows.includes(index) ? " is-active" : ""}`} data-port={index} cx={portX} cy={rowY} r="3" />
        )))}
      </svg>

      <div class="fig-chat" style={`left: ${x(CHAT.x)}; width: ${x(CHAT.width)}`}>
        <div class="fig-chat-head">
          <span class="label">Your chat</span>
          <div class="fig-you" role="group" aria-label="You work in">
            {graphAgents.map((entry) => (
              <button type="button" data-from={entry.id} aria-pressed={entry.id === from ? "true" : "false"} aria-label={entry.app} title={entry.app}>
                <AgentIcon name={entry.id} size={16} />
              </button>
            ))}
          </div>
        </div>
        <p class="fig-you-name"><b data-you-app>{you.app}</b> <span data-you-model>{you.model}</span></p>
        <p class="fig-request"><span class="label">You</span><span data-request>{task.request}</span></p>
        <p class="fig-call" style={`top: calc(${y(CALL_Y)} - 17px)`}>
          <span class="label" data-call-label>Tool</span><span data-call>{workers.length === 1 ? `ennodia_run: ${agent(workers[0]!).app}` : workers.length ? `ennodia_run: ${workers.length} agents` : `${you.app}’s own tools`}</span>
        </p>
        <p class="fig-history" data-history hidden={!workers.length}>Your history stays in {you.app}</p>
        <p class="fig-answer" style={`top: calc(${y(ANSWER_Y)} - 24px)`}>
          <span class="label" data-answer-from>{you.app}</span><span data-answer>{text.backShort}</span>
        </p>
      </div>

      <p class="fig-label fig-label-out" data-out-label style={`left: ${x(CHAT.width + 18)}; top: calc(${y(CALL_Y)} - 44px)`} hidden={!workers.length}>
        <span data-item>{text.item}</span><span class="fig-note">with the model and a time limit</span>
      </p>

      <ul class="fig-agents" style={`left: ${x(AGENTS.x)}; width: ${x(AGENTS.width)}`}>
        {graphAgents.map((entry) => {
          const index = row.indexOf(entry.id);
          return (
            <li
              data-agent={entry.id}
              class={workers.includes(entry.id) ? "is-active" : undefined}
              hidden={index < 0}
              style={index < 0 ? undefined : `top: calc(${y(AGENTS.rows[index]!)} - 16px)`}
            >
              <span class="fig-agent-head"><AgentIcon name={entry.id} size={14} /><b>{entry.app}</b><span class="fig-agent-model">{entry.model}</span></span>
              <span class="fig-agent-strength">{entry.strength}</span>
              <span class="fig-agent-runs">Fresh session, its own account</span>
            </li>
          );
        })}
      </ul>

      <span class="fig-compare label" data-compare style={`left: ${x(join.x)}; top: ${y(join.y)}`} hidden={!compare}>Compare</span>

      <div class="fig-strip" style={`left: ${x(STRIP.x)}; top: ${y(STRIP.y)}; width: ${x(STRIP.width)}; height: ${y(STRIP.height)}`}>
        {strips.map((strip) => (
          <video data-strip={strip.task} data-note={strip.note} data-credit-text={strip.credit?.text} data-credit-href={strip.credit?.href} hidden={strip.task !== taskId} aria-hidden="true" width="630" height="85" poster={`/studies/${strip.name}.jpg`} muted playsinline preload={strip.task === taskId ? "metadata" : "none"}>
            <source src={`/studies/${strip.name}.mp4`} type="video/mp4" />
            <source src={`/studies/${strip.name}.webm`} type="video/webm" />
          </video>
        ))}
      </div>

      <p class="fig-label fig-label-back" data-back-label style={`left: ${x(STRIP.x)}; top: calc(${y(ANSWER_Y)} + 10px)`} hidden={!workers.length}>{text.backLabel}</p>

      <ol class="fig-steps" data-steps hidden>
        {steps.map((point, index) => (
          <li data-step={index} data-side={index === 1 || index === 2 ? "left" : "right"} style={`left: ${x(point.x)}; top: ${y(point.y)}`}><span class="fig-step-dot">{index + 1}</span><span data-step-text>{text.steps[index] ?? ""}</span></li>
        ))}
      </ol>
    </div>

    <ul class="fig-key" aria-label="Key">
      <li><span class="fig-key-mark is-route" aria-hidden="true"></span>Through Ennodia</li>
      <li><span class="fig-key-mark is-hand" aria-hidden="true"></span>By hand</li>
      <li><span class="fig-key-mark is-idle" aria-hidden="true"></span>Also reachable</li>
    </ul>

    <figcaption class="caption">
      <span class="caption-title"><span class="caption-number">Fig. 2</span>Where the work goes when your agent hands off a task</span>
      <span class="fig-summary" data-summary aria-live="polite">{text.summary}</span>
      <span class="caption-note" data-strip-note>{shown.note}</span>
      <span class="caption-note fig-evidence" data-evidence>
        {task.recorded && task.recorded.from === from
          ? <><span><span class="recorded-dot" aria-hidden="true"></span>{task.recorded.text}</span><a class="text-link" href={task.recorded.href}>Read the write-up <Icon name="arrow-up-right" size={14} /></a></>
          : <span>Example request. Model access depends on your installed agents and accounts.</span>}
      </span>
      <span class="caption-note fig-credit" data-credit hidden={!credit}>{credit && <a href={credit.href}>{credit.text}</a>}</span>
    </figcaption>
  </figure>
</section>
<script>import "../scripts/agent-graph";</script>
