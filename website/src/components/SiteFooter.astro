---
import Icon from "./Icon.astro";
import Wordmark from "./Wordmark.astro";

const repo = "https://github.com/cherninlab/ennodia";
---
<footer class="site-footer wrap">
  <div class="footer-note">
    <p>If <Wordmark class="inline-wordmark" label="Ennodia" /> is useful to you,<br />a star on GitHub would mean a lot.</p>
    <a class="star-link" href={repo}><Icon name="star" size={18} /> Star on GitHub <Icon name="arrow-up-right" size={16} /></a>
  </div>
  <div class="footer-base">
    <span>Made by <a href="https://github.com/cherninlab">Chernin Lab</a></span>
    <a href={`${repo}/blob/main/LICENSE`}>MIT licensed</a>
  </div>
</footer>
