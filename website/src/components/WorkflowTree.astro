---
interface Props {
  root: string;
  branches: { title: string; lines: string[] }[];
  outcome: string[];
}
const { root, branches, outcome } = Astro.props;
---
<div class="workflow-tree">
  <p>{root}</p>
  <ul>
    {branches.map(branch => <li><p>{branch.title}</p>{branch.lines.map(line => <p class="tree-detail">{line}</p>)}</li>)}
  </ul>
  <div class="tree-outcome">{outcome.map(line => <p>{line}</p>)}</div>
  <slot />
</div>
<style>
  @font-face {
    font-family: "Martian Mono";
    src: url("/fonts/martian-mono-regular.ttf") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  .workflow-tree { width: 100%; min-width: 0; text-align: left; color: var(--ink); font: 15px/1.8 "Martian Mono", var(--mono); font-variant-ligatures: none; overflow-wrap: anywhere; }
  p { margin: 0; }
  ul { list-style: none; margin: 0; padding: 1.8em 0 0; }
  li { position: relative; padding: 0 0 1.8em 3ch; }
  li::before { content: ""; position: absolute; left: .5ch; top: -1.8em; bottom: 0; border-left: 1px solid var(--muted); }
  li::after { content: ""; position: absolute; left: .5ch; top: .9em; width: 1.5ch; border-top: 1px solid var(--muted); }
  li:last-child { padding-bottom: 0; }
  li:last-child::before { bottom: auto; height: 2.7em; }
  .tree-detail { color: var(--muted); }
  .tree-outcome { margin-top: 1.8em; }
  .tree-outcome p + p { color: var(--muted); }
</style>
