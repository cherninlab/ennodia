---
import type { Workflow } from "../data/workflows";
import WorkflowResult from "./WorkflowResult.astro";
import WorkflowTree from "./WorkflowTree.astro";
interface Props { workflow: Workflow; evidence?: boolean }
const { workflow, evidence = true } = Astro.props;
const { task, worker, action, source, finding, checkLabel, check, next } = workflow.diagram;
---
<WorkflowTree
  root={task}
  branches={[
    { title: "Your chat · Codex", lines: [source] },
    { title: `Ennodia → ${worker}`, lines: [action, `${checkLabel}: ${check}`] },
  ]}
  outcome={[`Back in your chat: ${finding}`, next]}
>
  {evidence ? <WorkflowResult workflow={workflow} /> : <a class="tree-evidence" href={`#result-${workflow.id}`}>{workflow.evidence.summary}</a>}
</WorkflowTree>
<style>
  .tree-evidence { display: inline-block; margin-top: 16px; text-decoration: underline; text-underline-offset: 4px; }
</style>
