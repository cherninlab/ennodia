---
import type { Workflow } from "../data/workflows";
import WorkflowResult from "./WorkflowResult.astro";
import logoSrc from "../../../docs/assets/logo.svg?url";
import codexLogoSrc from "../../../docs/assets/agents/codex-color.svg?url";

interface Props { workflow: Workflow }
const { workflow } = Astro.props;
const { task, worker, action, source, finding, checkLabel, check, next } = workflow.diagram;
---
<div class="workflow-diagram">
  <div class="chat-heading"><img src={codexLogoSrc} alt="" width="20" height="20" />Your chat in Codex</div>
  <div class="conversation-line">
    <p class="chat-request" data-phase="out">{task}</p>
    <section class="delegated-work" aria-label="Ennodia work in a separate agent session">
      <span class="handoff-out" aria-hidden="true">───→</span>
      <header class="delegation-heading">
        <img src={logoSrc} alt="Ennodia" width="113" height="24" />
      </header>
      <div class="worker-step" data-phase="worker">
        <p>{worker} · {action}</p>
        <p class="worker-source">{source}</p>
      </div>
      <div class="worker-findings" data-phase="check">
        <p>{checkLabel}<br />{check}</p>
      </div>
      <div data-phase="saved"><WorkflowResult workflow={workflow} /></div>
      <span class="handoff-return" aria-hidden="true">←───</span>
    </section>
    <div class="chat-result">
      <p class="return-label">Back in your chat</p>
      <p data-phase="return">{finding}</p>
      <p data-phase="next">{next}</p>
    </div>
  </div>
</div>
<style>
  .workflow-diagram {
    --trace: #3260d3;
    --thread-line: #b9bcb6;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    text-align: left;
    color: var(--ink);
    font: 15px/1.6 var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    font-variant-ligatures: none;
  }
  p { margin: 0; }
  .chat-heading { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
  .chat-heading img { filter: grayscale(1); }
  .conversation-line { position: relative; }
  .conversation-line::before { content: ""; position: absolute; left: 0; top: 0; bottom: 12px; border-left: 1px solid var(--thread-line); }
  .chat-request, .chat-result { position: relative; padding-left: 24px; }
  .chat-request::before, .chat-result::before { content: ""; position: absolute; left: 0; top: 12px; width: 14px; border-top: 1px solid var(--thread-line); }
  .delegated-work { position: relative; margin: 28px 0 28px 4ch; padding: 22px 26px; border: 1px solid var(--thread-line); }
  .handoff-out, .handoff-return { position: absolute; left: calc(-4ch - 1px); color: #62685e; white-space: pre; }
  .handoff-out { top: 22px; }
  .handoff-return { bottom: 20px; }
  .delegation-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .delegation-heading img { width: 113px; height: auto; }
  .worker-step { margin-top: 20px; }
  .worker-source { color: #62685e; }
  .worker-findings { display: grid; gap: 12px; margin-top: 16px; }
  .return-label { margin-bottom: 8px; color: #62685e; }
  .chat-result { padding-bottom: 0; }
  .chat-result::after { content: ""; position: absolute; left: 0; top: 13px; bottom: 0; border-left: 1px solid var(--paper); }
  .chat-result > p:last-child { margin-top: 4px; }
  [data-tracing] .handoff-out { animation: emphasize .9s ease .1s both; }
  [data-tracing] [data-phase="worker"] { animation: emphasize 1s ease 1s both; }
  [data-tracing] [data-phase="check"] { animation: emphasize 1s ease 2.1s both; }
  [data-tracing] [data-phase="saved"] { animation: emphasize .8s ease 3.2s both; }
  [data-tracing] .handoff-return, [data-tracing] [data-phase="return"] { animation: emphasize 1s ease 4.1s both; }
  [data-tracing] [data-phase="next"] { animation: emphasize .8s ease 5s both; }
  @keyframes emphasize { 0%, 100% { color: inherit; } 35%, 75% { color: var(--trace); } }
  @media (max-width: 480px) {
    .workflow-diagram { font-size: 14px; }
    .delegated-work { padding: 18px; margin-block: 24px; }
    .delegation-heading { gap: 10px; padding-bottom: 16px; }
    .worker-step { margin-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-tracing] [data-phase], [data-tracing] .handoff-out, [data-tracing] .handoff-return { animation: none; }
  }
</style>
