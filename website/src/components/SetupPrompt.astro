---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  heading?: string;
}

// The prompt is the install: your agent reads the page and sets itself up.
// The manual route sits right under it for readers who check first.
const { id, heading = "Just ask your agent:" } = Astro.props;
const prompt = "Try Ennodia in this conversation: https://try-ennodia.cherninlab.com";
---
<div class="try-prompt setup-prompt">
  <h2 id={`${id}-title`}>{heading}</h2>
  <div class="copy-address">
    <p id={id}>{prompt}</p>
    <button type="button" data-copy-target={id} aria-label="Copy the setup prompt">
      <Icon name="copy" class="copy-icon" size={16} />
      <Icon name="check" class="check-icon" size={16} />
      <span class="copy-text">Copy</span>
    </button>
  </div>
  <span class="copy-feedback" role="status" aria-live="polite"></span>
  <p class="try-note">
    <span>Free, open source, and runs on your computer.</span>
    <a class="text-link" href="/docs/getting-started/#manual-setup">Set it up yourself <Icon name="arrow-right" size={14} /></a>
  </p>
</div>
