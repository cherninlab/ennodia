---
import type { AgentId } from "../data/agents";

interface Props {
  name: AgentId;
  size?: number;
}

// Agents are drawn in ink from the agent logo font, so that in a figure
// color only ever means Ennodia's path. The glyph follows the text color.
const glyphs: Record<AgentId, string> = {
  antigravity: "antigravity",
  claude: "claude-code",
  cline: "cline",
  codex: "codex",
  hermes: "hermes-agent",
  kilo: "kilo-code",
  kiro: "kiro",
  opencode: "opencode",
};
const { name, size = 22 } = Astro.props;
---
<span class={`agent-icon agent-logo agent-logo--${glyphs[name]}`} style={`font-size: ${size}px`} aria-hidden="true"></span>
