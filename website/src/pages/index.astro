---
import "../styles/landing.css";
import ExchangeWall from "../components/ExchangeWall.astro";
import { exchangeListSchema } from "../data/exchange-schema";
import { ArrowUpRight, Check, ChevronDown, Copy, Star } from "@lucide/astro";
import logo from "../../../docs/assets/logo.svg?url";
import claude from "../../../docs/assets/agents/claudecode-color.svg?url";
import codex from "../../../docs/assets/agents/codex-color.svg?url";
import opencode from "../../../docs/assets/agents/opencode-light.svg?url";
import antigravity from "../../../docs/assets/agents/antigravity-color.svg?url";
import kilo from "../../../docs/assets/agents/kilocode.svg?url";
import kiro from "../../../docs/assets/agents/kiro-color.svg?url";
import cline from "../../../docs/assets/agents/cline.svg?url";
import hermes from "../../../docs/assets/agents/hermesagent.svg?url";

const title = "I created Ennodia to stop copying answers from one AI to another.";
const description = "Ennodia lets your agent send work to other installed agents and bring their findings back to the same conversation. A local, open-source tool.";
const site = Astro.site ?? new URL("https://ennodia.cherninlab.com");
const setupPrompt = "Try Ennodia in this conversation: https://try-ennodia.cherninlab.com";
const agents = [
  { name: "Claude Code", logo: claude }, { name: "Codex CLI", logo: codex },
  { name: "OpenCode", logo: opencode }, { name: "Antigravity", logo: antigravity },
  { name: "Kilo Code", logo: kilo }, { name: "Kiro", logo: kiro },
  { name: "Cline", logo: cline }, { name: "Hermes Agent", logo: hermes },
];
const questions = [
  { question: "Can I use my existing subscriptions?", answer: "Yes. Ennodia is a local tool. It has no subscription and doesn’t require you to change the ones you have.", href: "/docs/reference/supported-harnesses/", link: "See supported tools" },
  { question: "Does everything stay on my computer?", answer: "Ennodia runs on your computer, with no Ennodia-hosted service. Your chosen agents can still send prompts and files to their model providers.", href: "/docs/concepts/data-governance/", link: "How data is handled" },
  { question: "Does it remember what worked?", answer: "It keeps a local run history, including outputs and failures, so you can look back. Learning which model or skill to choose next is still planned.", href: "/docs/guides/understand-results/", link: "What the history records" },
  { question: "Will this use more tokens?", answer: "It can. More agents use more tokens, but getting unstuck can also save repeated attempts. You can limit agent runs and estimated input tokens. We’re making Ennodia as efficient as we can while keeping the benefit of different models thinking together.", href: "/docs/guides/budgets-and-limits/", link: "Set limits for a run" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={site.toString()} />
  <meta name="theme-color" content="#f6f4ee" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ennodia" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={site.toString()} />
  <meta property="og:image" content={new URL("/og.png", site).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <nav aria-label="Main navigation">
      <a href="/docs/">Docs</a>
      <a href="https://github.com/cherninlab/ennodia">GitHub <ArrowUpRight size={14} aria-hidden="true" /></a>
    </nav>
  </header>
  <main id="main">
    <section class="intro wrap" aria-labelledby="intro-title">
      <h1 id="intro-title">I created <img class="inline-wordmark" src={logo} alt="Ennodia" width="47" height="10" /> to <strong>stop copying answers</strong> from <strong>one AI to another.</strong></h1>
      <p class="intro-letter">Now I can tell Claude Code to get <strong>Codex’s opinion</strong>, or have a few agents research a question and <strong>compare their findings.</strong></p>
      <div class="try-prompt" id="try" aria-labelledby="try-title">
        <h2 id="try-title">Just ask your agent:</h2>
        <div class="copy-address">
          <p id="setup-prompt">{setupPrompt}</p>
          <button type="button" data-copy-target="setup-prompt" aria-label="Copy setup prompt"><Copy class="copy-icon" size={21} aria-hidden="true" /><Check class="check-icon" size={21} aria-hidden="true" /></button>
        </div>
        <span class="copy-feedback" role="status" aria-live="polite"></span>
        <p class="intro-note">Free, open source, and runs on your computer.</p>
      </div>
    </section>

    <ExchangeWall />

    <section class="questions wrap" aria-labelledby="questions-title">
      <h2 id="questions-title">Good to know.</h2>
      <div class="question-list">
        <details>
          <summary>Which tools can I use?<ChevronDown size={20} aria-hidden="true" /></summary>
          <div class="answer">
            <p>Ennodia uses the agents on your computer, with the models and access you’ve set up.</p>
            <ul class="agent-list">{agents.map(agent => <li><img src={agent.logo} alt="" width="27" height="27" /><span>{agent.name}</span></li>)}</ul>
            <a class="text-link" href="/docs/reference/supported-harnesses/">Check compatibility <ArrowUpRight size={15} aria-hidden="true" /></a>
          </div>
        </details>
        {questions.map(item => <details><summary>{item.question}<ChevronDown size={20} aria-hidden="true" /></summary><div class="answer"><p>{item.answer}</p><a class="text-link" href={item.href}>{item.link}<ArrowUpRight size={15} aria-hidden="true" /></a></div></details>)}
        <details>
          <summary>Can I set it up myself?<ChevronDown size={20} aria-hidden="true" /></summary>
          <div class="answer"><a class="text-link" href="/docs/getting-started/#manual-setup">See the manual setup guide <ArrowUpRight size={15} aria-hidden="true" /></a></div>
        </details>
      </div>
    </section>
  </main>
  <footer class="site-footer wrap">
    <div class="footer-note">
      <p>If <img class="inline-wordmark" src={logo} alt="Ennodia" width="47" height="10" /> is useful to you,<br />a star on GitHub would mean a lot.</p>
      <a class="star-link" href="https://github.com/cherninlab/ennodia"><Star size={18} aria-hidden="true" /> Star on GitHub <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <div class="footer-base">
      <span>Made by <a href="https://github.com/cherninlab">Chernin Lab</a></span>
      <a href="https://github.com/cherninlab/ennodia/blob/main/LICENSE">MIT licensed</a>
    </div>
  </footer>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": ["SoftwareApplication", "SoftwareSourceCode"], "@id": new URL("/#software", site).toString(), name: "Ennodia", description, url: site.toString(), applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux", isAccessibleForFree: true, license: "https://github.com/cherninlab/ennodia/blob/main/LICENSE", codeRepository: "https://github.com/cherninlab/ennodia" },
      exchangeListSchema(site),
    ],
  }).replace(/</g, "\\u003c")} />
  <script>import "../scripts/landing";</script>
</body>
</html>
