---
import "../styles/landing.css";
import logoSrc from "../../../docs/assets/logo.svg?url";
import githubIconSrc from "../../../docs/assets/icons/github.svg?url";

import codexLogoSrc from "../../../docs/assets/agents/codex-color.svg?url";
import claudecodeLogoSrc from "../../../docs/assets/agents/claudecode-color.svg?url";
import opencodeLogoSrc from "../../../docs/assets/agents/opencode-light.svg?url";
import kilocodeLogoSrc from "../../../docs/assets/agents/kilocode.svg?url";
import kiroLogoSrc from "../../../docs/assets/agents/kiro-color.svg?url";
import clineLogoSrc from "../../../docs/assets/agents/cline.svg?url";
import hermesLogoSrc from "../../../docs/assets/agents/hermesagent.svg?url";
import antigravityLogoSrc from "../../../docs/assets/agents/antigravity-color.svg?url";

const pageTitle = "Ennodia — keep your agent, get another way forward";
const pageDescription = "Try other agents, models, and skills from your familiar AI workflow. Bring useful findings back to the same conversation.";
const siteUrl = Astro.site ?? new URL("https://ennodia.cherninlab.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL("/og.png", siteUrl).toString();
const socialImageAlt = "Ennodia wordmark.";
const adapters = [
  { name: "Codex", logoSrc: codexLogoSrc },
  { name: "Claude Code", logoSrc: claudecodeLogoSrc },
  { name: "OpenCode", logoSrc: opencodeLogoSrc },
  { name: "Kilo Code", logoSrc: kilocodeLogoSrc },
  { name: "Kiro", logoSrc: kiroLogoSrc },
  { name: "Cline", logoSrc: clineLogoSrc },
  { name: "Hermes Agent", logoSrc: hermesLogoSrc },
  { name: "Antigravity", logoSrc: antigravityLogoSrc },
];


const recipes = [
  { number: "01", title: "The task is stuck", text: "You have tried a fix twice. A focused second attempt can test a different cause before you start over.", prompt: "Use Ennodia to get a second opinion on this bug. Give one available agent the failing test and our attempted fixes. Request a different explanation and a way to test it. Bring the findings back here." },
  { number: "02", title: "A skill might help", text: "Try a skill in a separate task. Keep its useful findings without loading the whole experiment into your main conversation.", prompt: "Use Ennodia to try an installed review skill on this change in a separate task. Keep the review read-only. Show the useful findings, irrelevant advice, and what remains unverified." },
  { number: "03", title: "The answers disagree", text: "Find the assumption behind the disagreement. Decide what to verify next, with the attempted approaches in view.", prompt: "Use Ennodia to compare these two answers. Identify their different assumptions, the evidence for each, and the smallest check that can settle the disagreement." },
];
const faqItems = [
  { question: "Where do I use Ennodia?", answer: "In your usual agent conversation. Ennodia connects through Model Context Protocol (MCP). You can use Codex or another compatible client." },
  { question: "What do I need installed?", answer: "Bun and at least one supported agent command-line interface (CLI), with working provider access. Your agent can help configure Ennodia." },
  { question: "Do I need another subscription?", answer: "Ennodia is free and open source. The agents use their configured model access. Provider subscriptions, quotas, and charges still apply." },
  { question: "What if the other agent also fails?", answer: "That attempt remains useful context for your next decision. A failed login differs from an approach that did not help. Neither proves a task impossible." },
  { question: "Will this save tokens or time?", answer: "It can reduce manual switching and repeated work. Additional attempts also consume resources. We have not established general time or token savings." },
  { question: "Where does my code go?", answer: "Ennodia runs locally without an Ennodia-hosted service. Each selected agent can send material to its configured provider. Local run history can be disabled." },
  { question: "Does it choose and update every model for me?", answer: "You can select models and skills or request a suggested team. Automatic updates and recommendations learned from past outcomes are future work." },
];
const faqStructuredData = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) };
const applicationStructuredData = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Ennodia", description: pageDescription, url: siteUrl.toString(), applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux", isAccessibleForFree: true, license: "https://github.com/cherninlab/ennodia/blob/main/LICENSE", codeRepository: "https://github.com/cherninlab/ennodia" };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfbfa" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ennodia" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />


    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" aria-label="Ennodia home"><img class="wordmark" src={logoSrc} alt="Ennodia" /></a>
      <nav aria-label="Main navigation">
        <a href="/docs/getting-started/">Docs</a>
        <a class="github-link" href="https://github.com/cherninlab/ennodia"><img src={githubIconSrc} alt="" /> GitHub</a>
      </nav>
    </header>
    <main id="main-content">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">For the task you want to finish</p>
          <h1 id="hero-title">Keep your agent.<br /><span>Get another<br class="wide-only" /> way forward.</span></h1>
          <p class="hero-description">When a task stalls, try another agent, model, or skill without rebuilding the conversation. Bring useful findings back to the tool you know.</p>
          <div class="actions">
            <a class="button primary" href="/docs/getting-started/">Add Ennodia to your agent <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#in-practice">See it in use <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">Open source. Runs locally. Uses your installed agents.</p>
        </div>
        <figure class="work-example" id="in-practice">
          <figcaption><span class="status-dot" aria-hidden="true"></span> One task. The same conversation.</figcaption>
          <div class="request"><span class="speaker">The task</span><p>Check Ennodia’s local server.<br />Can a browser start unauthorized work?</p></div>
          <ol class="attempts">
            <li><span class="attempt-mark muted" aria-hidden="true">×</span><div><strong>Claude Code</strong><span>Login expired. The task did not start.</span></div></li>
            <li><span class="attempt-mark" aria-hidden="true">↗</span><div><strong>OpenCode</strong><span>Reproduced the problem. Wrote a fix and tests.</span></div></li>
            <li><span class="attempt-mark done" aria-hidden="true">✓</span><div><strong>Back with the primary agent</strong><span>Reviewed the changes, tightened validation, and ran the tests.</span></div></li>
          </ol>
          <div class="example-result"><span class="speaker">The result</span><p>A reviewed fix, with the failed attempt still visible.</p></div>
          <a class="case-link" href="/docs/evidence/building-ennodia/">Development case · September 2026 <span aria-hidden="true">↗</span></a>
        </figure>
      </section>

      <section class="section wrap" aria-labelledby="why-title">
        <div><p class="eyebrow">Less to manage</p><h2 id="why-title">You came to solve a task.<br />The tool search can wait.</h2></div>
        <div class="section-copy"><p>A new model appears. A skill looks promising. Your current agent is stuck. Trying something else can mean another interface and another explanation.</p><p>Ennodia gives your primary agent a way to try those alternatives and return the findings here. You keep the conversation and choose the next step.</p></div>
      </section>

      <section class="recipes wrap" aria-labelledby="recipes-title">
        <p class="eyebrow">Start with one useful attempt</p>
        <div class="section-heading"><h2 id="recipes-title">Three reasons to reach<br />for Ennodia.</h2><a class="text-link" href="/docs/guides/recipes/">Read the recipes ↗</a></div>
        <div class="recipe-grid">{recipes.map((recipe) => (
          <article class="recipe"><span class="recipe-number">{recipe.number}</span><h3>{recipe.title}</h3><p>{recipe.text}</p><details><summary>Try this prompt</summary><div class="prompt-box"><p>{recipe.prompt}</p><button type="button" data-copy-code={recipe.prompt}>Copy prompt</button><span class="copy-status" aria-live="polite"></span></div></details></article>
        ))}</div>
      </section>

      <section class="section wrap" aria-labelledby="outcomes-title">
        <div><p class="eyebrow">Useful beyond a second answer</p><h2 id="outcomes-title">Know what to try next.</h2></div>
        <div class="section-copy"><ul class="outcomes"><li><strong>A different explanation.</strong> Test an assumption your first attempt missed.</li><li><strong>A useful part of a skill.</strong> Bring back the finding that helps this task.</li><li><strong>A tested dead end.</strong> Keep a record of an approach that did not help under these conditions.</li></ul><p class="small-note">Agreement is evidence to examine. Your primary agent still checks the result.</p></div>
      </section>

      <section class="section wrap" aria-labelledby="agents-title">
        <div><p class="eyebrow">Your existing tools</p><h2 id="agents-title">More options.<br />One familiar workflow.</h2><a class="text-link" href="/docs/reference/supported-harnesses/">Check compatibility ↗</a></div>
        <div class="section-copy"><ul class="agent-grid">{adapters.map((agent) => (<li><img src={agent.logoSrc} alt="" /><span>{agent.name}</span></li>))}</ul><p class="small-note">Model access and available skills depend on each installed agent and its provider configuration.</p></div>
      </section>

      <section class="section wrap" aria-labelledby="faq-title">
        <div><p class="eyebrow">Before you start</p><h2 id="faq-title">A few practical details.</h2></div>
        <div class="faq-list">{faqItems.map((item) => (<details><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div>
      </section>

      <section class="closing wrap" aria-labelledby="start-title">
        <p class="eyebrow">Keep the conversation going</p><h2 id="start-title">Try it on a task<br />you care about.</h2><p>Start with one small question and one additional agent.</p><div class="actions"><a class="button primary" href="/docs/getting-started/">Get started <span aria-hidden="true">↗</span></a><a class="text-link" href="/docs/evidence/">Explore the examples ↗</a></div>
      </section>
    </main>
    <footer class="site-footer wrap"><img class="wordmark" src={logoSrc} alt="Ennodia" /><p>Local software. MIT license.</p><a href="/docs/roadmap/">What comes next ↗</a></footer>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(applicationStructuredData)} />
    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-code]")) {
        button.addEventListener("click", async () => {
          const text = button.dataset.copyCode ?? "";
          const status = button.parentElement?.querySelector(".copy-status");
          try {
            await navigator.clipboard.writeText(text);
            if (status) status.textContent = "Copied";
          } catch {
            if (status) status.textContent = "Select the prompt above to copy it.";
          }
        });
      }
    </script>
  </body>
</html>
