---
import Icon from "../components/Icon.astro";
import AgentGraph from "../components/AgentGraph.astro";
import AudioResultFigure from "../components/AudioResultFigure.astro";
import AlternativesFigure from "../components/AlternativesFigure.astro";
import LeadersFigure from "../components/LeadersFigure.astro";
import SetupPrompt from "../components/SetupPrompt.astro";
import Wordmark from "../components/Wordmark.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/landing.css";

// Talk about the reader's result, not about Ennodia: one claim with one
// measured number, what you get, the result itself, how a handoff runs, the
// premise, and the alternative you would otherwise use. Answers to setup,
// data, and cost questions live at /docs/questions/, so the pitch does not
// raise them. A third tool to unite the others would be a third standard, so
// the page never asks anyone to move.
const title = "Ennodia isn’t another agent. It connects the agents you use";
const description = "A free, open-source MCP server on your computer. The agent you use hands parts of a task to your other agents and gets their answers back.";
const site = Astro.site ?? new URL("https://ennodia.cherninlab.com");



// Why use Ennodia, in the reader's terms. Each line is true today. Learning
// from receipts is marked as next, as the roadmap has it.
const benefits = [
  { title: "Keep the app you like", text: "Ennodia has no window of its own. You work in your agent as before, and it can now reach the others." },
  { title: "Your agents work together", text: "Any agent can hand part of a task to any other and get the answer back in your chat." },
  { title: "Nothing to pay, nothing to join", text: "Ennodia is free and open source, with no account. It uses the agents and plans you have." },
  { title: "It grows with your agents", text: "It is a set of tools, not a framework or a method. Each new model one agent gains becomes an ability for all of them." },
  { title: "It stays on your computer", text: "Every handoff leaves a receipt there: who did the work, how long it took, and what came back. Nothing goes to Ennodia." },
  { title: "Less to keep up with", text: "You don’t need to follow every new model. Name the task, and your agent hands it to one that can do it." },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "SoftwareSourceCode"],
  "@id": new URL("/#software", site).toString(),
  name: "Ennodia",
  description,
  url: site.toString(),
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux",
  isAccessibleForFree: true,
  license: "https://github.com/cherninlab/ennodia/blob/main/LICENSE",
  codeRepository: "https://github.com/cherninlab/ennodia",
};
---
<SiteLayout title={title} description={description} structuredData={structuredData}>
  <section class="intro wrap" aria-labelledby="intro-title">
    <h1 id="intro-title" aria-label="Ennodia isn’t another agent. It connects the agents you use."><Wordmark class="inline-wordmark" label="Ennodia" /> <span class="quiet">isn’t another agent</span> <span class="claim"><span class="quiet">It</span> connects the agents you use</span></h1>
    <p class="intro-letter">A free MCP server for Codex, Claude Code, and six other agents. When your agent lacks an ability, it calls one that has it and keeps the answer in your chat.</p>
    <p class="intro-proof">Codex can’t hear audio. In a 30-clip test, it got 10 of 10 speech questions right through Gemini, and 4 of 10 alone. <a class="text-link" href="#result">See Fig. 1 <Icon name="arrow-down" size={14} /></a></p>
    <SetupPrompt id="setup-prompt" />
  </section>

  <section class="wrap why" id="why" aria-labelledby="why-title">
    <h2 id="why-title">Why use Ennodia</h2>
    <ul class="why-list" role="list">
      {benefits.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}
    </ul>
    <p class="why-next">
      <span>Next: Ennodia will read its receipts, so your agent stops repeating what failed.</span>
      <a class="text-link" href="/docs/roadmap/">Roadmap <Icon name="arrow-right" size={14} /></a>
      <a class="text-link" href="/docs/questions/">Questions about setup, data, and cost <Icon name="arrow-right" size={14} /></a>
    </p>
  </section>

  <section class="split wrap" id="result" aria-labelledby="result-title">
    <div class="split-head">
      <h2 id="result-title">What changes when Codex can listen</h2>
      <p>Codex can’t hear audio. In Fig. 1, each row runs from Codex alone to Codex with Ennodia, which hands the clip to Gemini. Speech rises from 4 to 10, and sound falls from 7 to 5.</p>
    </div>
    <AudioResultFigure />
  </section>

  <AgentGraph />

  <section class="split wrap" id="evidence" aria-labelledby="evidence-title">
    <div class="split-head">
      <h2 id="evidence-title">No model leads every task</h2>
      <p>Fig. 3 names the leader in four kinds of work, as each public leaderboard reports it. A different agent leads each row, so each agent you connect adds a strength. Fig. 4 shows when combining answers helps.</p>
    </div>
    <LeadersFigure />
  </section>

  <section class="split wrap" id="alternatives" aria-labelledby="alternatives-title">
    <div class="split-head">
      <h2 id="alternatives-title">Why not just switch apps?</h2>
      <p>Both of the usual ways move you out of the agent that knows your project. Read Fig. 5 across a row: where you work, who carries the work, and whose account it uses.</p>
    </div>
    <AlternativesFigure />
  </section>
</SiteLayout>
