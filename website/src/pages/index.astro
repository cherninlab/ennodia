---
import "../styles/landing.css";
import { ArrowRight, ArrowUpRight, Check, ChevronDown, Copy } from "@lucide/astro";
import logoSrc from "../../../docs/assets/logo.svg?url";
import codexLogoSrc from "../../../docs/assets/agents/codex-color.svg?url";
import claudecodeLogoSrc from "../../../docs/assets/agents/claudecode-color.svg?url";
import opencodeLogoSrc from "../../../docs/assets/agents/opencode-light.svg?url";
import kilocodeLogoSrc from "../../../docs/assets/agents/kilocode.svg?url";
import kiroLogoSrc from "../../../docs/assets/agents/kiro-color.svg?url";
import clineLogoSrc from "../../../docs/assets/agents/cline.svg?url";
import hermesLogoSrc from "../../../docs/assets/agents/hermesagent.svg?url";
import antigravityLogoSrc from "../../../docs/assets/agents/antigravity-color.svg?url";
import InstallLink from "../components/InstallLink.astro";
import WorkflowDiagram from "../components/WorkflowDiagram.astro";
import WorkflowTree from "../components/WorkflowTree.astro";
import HeroTitle from "../components/HeroTitle.astro";
import { workflows } from "../data/workflows";

const pageTitle = "Ennodia — connect your AI agents";
const pageDescription = "Ennodia lets your AI agent give work to other installed agents, try skills, and bring results back to the same conversation. Free and open source.";
const siteUrl = Astro.site ?? new URL("https://ennodia.cherninlab.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL("/og.png", siteUrl).toString();
const adapters = [
  { id: "codex", name: "Codex", logoSrc: codexLogoSrc },
  { id: "claude-code", name: "Claude Code", logoSrc: claudecodeLogoSrc },
  { id: "opencode", name: "OpenCode", logoSrc: opencodeLogoSrc },
  { id: "antigravity", name: "Antigravity", logoSrc: antigravityLogoSrc },
  { id: "kilo-code", name: "Kilo Code", logoSrc: kilocodeLogoSrc },
  { id: "kiro", name: "Kiro", logoSrc: kiroLogoSrc },
  { id: "cline", name: "Cline", logoSrc: clineLogoSrc },
  { id: "hermes-agent", name: "Hermes Agent", logoSrc: hermesLogoSrc },
];
const faqItems = [
  { question: "Is Ennodia another chat app?", answer: "Ennodia is an add-on for the agent you use. You stay in your usual conversation while it asks other installed agents to write code, answer questions, or review work." },
  { question: "What do I need to use it?", answer: "An app such as Codex that can connect to Ennodia, plus a supported agent installed on your computer. That agent needs a working account or API key. Your agent can use the setup address to check what’s missing and guide you through installation.", link: { href: "/docs/getting-started/#requirements", label: "Setup requirements" } },
  { question: "Does it work with my subscriptions?", answer: "Ennodia uses each installed agent’s configured access. That can be a subscription or an API key, depending on the agent and provider. Their quotas and charges still apply. Ennodia itself is free." },
  { question: "What happens to my code and files?", answer: "Ennodia runs locally. It passes the requested task to your selected agents, which can send material to their configured providers. There is no Ennodia-hosted service. Local run history can be disabled." },
  { question: "What if every agent gets stuck?", answer: "You have a record of the approaches tried and the evidence they produced. Use that to reconsider the task or test another assumption. Agreement between agents does not prove correctness or impossibility." },
  { question: "Will it always be faster or cheaper?", answer: "Additional agents consume resources. The aim is to reduce manual switching and repeated attempts across the whole task. We publish examples and recordings, but have not established general time or token savings." },
];
const faqStructuredData = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) };
const applicationStructuredData = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Ennodia", description: pageDescription, url: siteUrl.toString(), applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux", isAccessibleForFree: true, license: "https://github.com/cherninlab/ennodia/blob/main/LICENSE", codeRepository: "https://github.com/cherninlab/ennodia" };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ennodia" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="Ennodia wordmark." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <HeroTitle harnesses={adapters} />
          <InstallLink />
        </div>
        <div class="hero-visual" id="in-practice">
          <div class="audience-tabs" role="tablist" aria-label="Ennodia examples">
            {workflows.map((workflow, index) => (<button type="button" id={`tab-${workflow.id}`} role="tab" aria-controls={`panel-${workflow.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-audience={workflow.id}>{workflow.audience}</button>))}
          </div>
          {workflows.map((workflow, index) => (
            <div class="workflow-panel" id={`panel-${workflow.id}`} role="tabpanel" aria-labelledby={`tab-${workflow.id}`} hidden={index !== 0} data-workflow={workflow.id} tabindex="0">
              <WorkflowDiagram workflow={workflow} />
            </div>
          ))}
        </div>
      </section>
      <section class="use-cases wrap" id="for-you" aria-labelledby="examples-title">
        <h2 id="examples-title">Examples</h2>
        <div class="story-grid">{workflows.map((workflow) => (
          <article class="story-card">
            <div class="story-copy">
              <h3>{workflow.title}</h3><p>{workflow.description}</p>
              <details class="story-example">
                <summary>Try this with your agent <ChevronDown size={17} aria-hidden="true" /></summary>
                <div class="example-body"><p>Use your own {workflow.materials}. Paste this into the conversation where you’re working:</p><blockquote id={`prompt-${workflow.id}`}>{workflow.prompt}</blockquote><button type="button" class="text-button" data-copy-target={`prompt-${workflow.id}`}><Copy class="copy-icon" size={17} aria-hidden="true" /><Check class="copied-icon" size={17} aria-hidden="true" />Copy prompt</button><span class="copy-feedback" role="status"></span></div>
              </details>
            </div>
            <WorkflowDiagram workflow={workflow} evidence={false} />
          </article>
        ))}</div>
      </section>
      <section class="skill-section wrap" aria-labelledby="skill-title">
        <div class="skill-copy"><h2 id="skill-title">Compare skills without cluttering your conversation</h2><p>Try the same task with and without a requested skill in separate conversations. Compare the findings and failed attempts before deciding what to use.</p><a class="text-link" href="/docs/evidence/skill-trial/">See both recorded attempts <ArrowRight size={17} aria-hidden="true" /></a></div>
        <WorkflowTree root="Same code + same model" branches={[
          { title: "Plain review", lines: ["6 failing cases found"] },
          { title: "With review skill", lines: ["File read blocked"] },
        ]} outcome={["Findings kept", "Skill benefit not established"]} />
      </section>
      <section class="agents-section wrap" id="your-agents" aria-labelledby="agents-title">
        <h2 id="agents-title">Keep the tools you like</h2><p>Ennodia connects the agents on your computer, using your models and subscriptions.</p>
        <ul class="agent-list">{adapters.map(agent => <li><img src={agent.logoSrc} alt="" width="30" height="30" /><span>{agent.name}</span></li>)}</ul>
        <a class="text-link" href="/docs/reference/supported-harnesses/">Check compatibility <ArrowRight size={17} aria-hidden="true" /></a>
      </section>
      <section class="faq-section wrap" aria-labelledby="faq-title"><h2 id="faq-title">Frequently asked questions</h2><div class="faq-list">{faqItems.map(item => <details><summary>{item.question}<ChevronDown size={18} aria-hidden="true" /></summary><p>{item.answer}{item.link && <> <a href={item.link.href}>{item.link.label}</a>.</>}</p></details>)}</div></section>
      <section class="start-section wrap" id="get-started" aria-labelledby="start-title">
        <h2 id="start-title"><span class="start-title-lead">Try <img class="start-title-brand" src={logoSrc} alt="Ennodia" width="141" height="30" /></span> on the task you have open right now</h2>
        <InstallLink />
        <p>Use your preferred <a href="/docs/getting-started/">compatible chat app, CLI, or IDE</a>.<br />Your agent gets the instructions to install and connect Ennodia.</p>
        <a class="text-link" href="/docs/getting-started/#manual-setup">Manual setup <ArrowUpRight size={16} aria-hidden="true" /></a>
        <p class="github-invitation">If Ennodia fits your workflow, <a href="https://github.com/cherninlab/ennodia"><strong>give it a star on GitHub</strong></a>.</p>
      </section>
    </main>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(applicationStructuredData)} />
    <script>import "../scripts/landing";</script>
  </body>
</html>
