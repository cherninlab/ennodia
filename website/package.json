{
  "name": "@ennodia/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lottie": "bun run scripts/build-lottie.ts",
    "sync:docs": "bun run scripts/sync-docs.ts",
    "dev": "bun run sync:docs && astro dev",
    "build": "bun run sync:docs && astro build --force",
    "preview": "astro preview",
    "export:devto": "bun run scripts/export-devto.ts",
    "make:cover": "bun run scripts/make-cover.ts",
    "ensure:cloudflare-project": "bun run scripts/ensure-cloudflare-pages-project.ts",
    "deploy": "bun run build && wrangler pages deploy dist --project-name ennodia --branch main"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/starlight": "^0.37.4",
    "@lucide/astro": "^1.41.0",
    "astro": "^5.16.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "^4.103.0"
  }
}
