#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const cliPath = path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "src", "cli.ts");

const bunCheck = spawnSync("bun", ["--version"], { encoding: "utf8", timeout: 5_000 });

if (bunCheck.error || bunCheck.status !== 0) {
  process.stderr.write(
    "Ennodia requires Bun (1.3.14 or newer). Bun wasn't available on PATH or failed its version check.\n" +
      "Install Bun from https://bun.sh, then try again:\n" +
      "  curl -fsSL https://bun.sh/install | bash\n",
  );
  process.exit(1);
}

const bunVersion = bunCheck.stdout.trim();
const minimum = [1, 3, 14];
const parsed = /^([0-9]+)\.([0-9]+)\.([0-9]+)(?:[-+].*)?$/.exec(bunVersion);
const parts = parsed?.slice(1, 4).map(Number);
const firstDifference = parts?.findIndex((part, index) => part !== minimum[index]);
if (!parts || (firstDifference !== -1 && parts[firstDifference] < minimum[firstDifference]) || (firstDifference === -1 && bunVersion.split("+")[0].includes("-"))) {
  process.stderr.write(`Ennodia requires Bun >=1.3.14; found ${bunVersion}. Upgrade Bun with bun upgrade, then restart Ennodia.\n`);
  process.exit(1);
}

const result = spawnSync("bun", ["run", cliPath, ...process.argv.slice(2)], {
  stdio: "inherit",
  env: { ...process.env, ENNODIA_LAUNCHER_PATH: fileURLToPath(import.meta.url) },
});

process.exit(result.status ?? 1);
