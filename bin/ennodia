#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { createRequire } from "node:module";
import path from "node:path";
import { fileURLToPath } from "node:url";

const require = createRequire(import.meta.url);
const musl = process.platform === "linux" && !process.report.getReport().header.glibcVersionRuntime;
const name = `@cherninlab/ennodia-${process.platform}-${process.arch}${musl ? "-musl" : ""}`;
try {
  const own = require("../package.json");
  if (!own.optionalDependencies?.[name]) throw new Error(`Unsupported platform: ${process.platform}/${process.arch}.`);
  let metadata;
  try { metadata = require.resolve(`${name}/package.json`); }
  catch { throw new Error(`The platform executable (${name}) is missing. Reinstall Ennodia with npm optional dependencies enabled.`); }
  if (require(metadata).version !== own.version) throw new Error("Ennodia's executable version does not match its launcher. Reinstall Ennodia.");
  const binary = path.join(path.dirname(metadata), "bin", process.platform === "win32" ? "ennodia.exe" : "ennodia");
  const result = spawnSync(binary, process.argv.slice(2), {
    stdio: "inherit",
    env: { ...process.env, ENNODIA_LAUNCHER_PATH: fileURLToPath(import.meta.url) },
  });
  if (result.error) throw result.error;
  if (result.signal) process.kill(process.pid, result.signal);
  process.exit(result.status ?? 1);
} catch (error) {
  process.stderr.write(`Ennodia could not start: ${error.message}\n`);
  process.exit(1);
}
